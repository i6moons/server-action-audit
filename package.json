{
  "name": "server-action-audit",
  "version": "0.1.0",
  "description": "Find Next.js Server Actions that anyone can call: a CLI and an ESLint plugin that flag \"use server\" functions without an authorization check or input validation.",
  "keywords": [
    "nextjs",
    "next.js",
    "server-actions",
    "use-server",
    "security",
    "authorization",
    "auth",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "audit",
    "react-server-components",
    "next-safe-action",
    "appsec"
  ],
  "author": "Del Prudence (https://github.com/i6moons)",
  "license": "MIT",
  "homepage": "https://github.com/i6moons/server-action-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i6moons/server-action-audit.git"
  },
  "bugs": "https://github.com/i6moons/server-action-audit/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "server-action-audit": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./eslint": {
      "import": {
        "types": "./dist/eslint.d.ts",
        "default": "./dist/eslint.js"
      },
      "require": {
        "types": "./dist/eslint.d.cts",
        "default": "./dist/eslint.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=4.8.4"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
